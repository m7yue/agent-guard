# 复制为 .env 后填写，.env 已被 .gitignore 忽略，不会进仓库。
# 不填任何值也能跑：执行器会自动回退到 MockModel（脚本化演示）。
#
# 变量一律带 AGENTGUARD_ 前缀（与 AGENTGUARD_WORKSPACE / AGENTGUARD_STATE_DIR 同一约定）。
# 原因：ANTHROPIC_* 是 Claude 工具链的事实保留名，终端里常见的导出会静默压过 .env
# （process.loadEnvFile() 不覆盖已存在的变量，实测见 PROGRESS 环境笔记 E-07）。
#
# 新旧映射（2026-11-09 改名）：
#   ANTHROPIC_BASE_URL      → AGENTGUARD_MODEL_BASE_URL
#   ANTHROPIC_AUTH_TOKEN    → AGENTGUARD_MODEL_AUTH_TOKEN
#   ANTHROPIC_API_KEY       → AGENTGUARD_MODEL_API_KEY
#   MODEL_ID                → AGENTGUARD_MODEL_ID
#   MODEL_MAX_TOKENS        → AGENTGUARD_MODEL_MAX_TOKENS
#   MODEL_TIMEOUT_MS        → AGENTGUARD_MODEL_TIMEOUT_MS
#   EMBEDDING_PROVIDER      → AGENTGUARD_EMBEDDING_PROVIDER
#   EMBEDDING_MODEL         → AGENTGUARD_EMBEDDING_MODEL
#   EMBEDDING_DIMENSIONS    → AGENTGUARD_EMBEDDING_DIMENSIONS
#   EMBEDDING_BATCH         → AGENTGUARD_EMBEDDING_BATCH
#   ZHIPU_API_KEY           → AGENTGUARD_ZHIPU_API_KEY

# ── 聊天模型（任意 Anthropic 兼容端点）───────────────────────────────
# DeepSeek 官方兼容端点：
AGENTGUARD_MODEL_BASE_URL=https://api.deepseek.com/anthropic

# 二选一：AUTH_TOKEN 走 Bearer，API_KEY 走 x-api-key
AGENTGUARD_MODEL_AUTH_TOKEN=
AGENTGUARD_MODEL_API_KEY=

# 模型 ID：deepseek-chat（经济）| deepseek-reasoner（推理）
AGENTGUARD_MODEL_ID=deepseek-chat

# 单次响应最大 token
AGENTGUARD_MODEL_MAX_TOKENS=512

# 请求超时（毫秒）
AGENTGUARD_MODEL_TIMEOUT_MS=60000

# ── 历史会话检索（RAG）───────────────────────────────────────
# 智谱密钥（embedding 用）；只放 .env，不进仓库
AGENTGUARD_ZHIPU_API_KEY=

# embedding 提供方：fake（默认，离线确定性，词法信号）| zhipu（真实语义）
# 配了 zhipu 但缺 key 时自动回退 fake 并记日志
AGENTGUARD_EMBEDDING_PROVIDER=fake

# 模型与维度（智谱 embedding-3 支持 256–2048）
AGENTGUARD_EMBEDDING_MODEL=embedding-3
AGENTGUARD_EMBEDDING_DIMENSIONS=1024

# 单次批量上限（智谱接口最多 64，配大了也按 64 收口）
AGENTGUARD_EMBEDDING_BATCH=32

# ── 检索重排──────────────────────────────────────
# 重排提供方：off（默认，不重排）| zhipu（真实重排）| fake（离线确定性，测试用）
# 配了 zhipu 但缺 AGENTGUARD_ZHIPU_API_KEY 时不重排并记日志
AGENTGUARD_RERANK_PROVIDER=off

# 重排模型名（智谱文本重排序，实测可用值 rerank）
AGENTGUARD_RERANK_MODEL=rerank

# 向量排序后送进重排的候选数（top-N 的 N；500 字/块 × 20 ≈ 10k 字符，接口上限 32k 字符）
AGENTGUARD_RERANK_CANDIDATES=20
